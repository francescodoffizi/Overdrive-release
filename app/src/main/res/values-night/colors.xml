<?xml version="1.0" encoding="utf-8"?>
<!--
  DARK palette — what was previously the only palette in values/colors.xml.
  Keys here MIRROR the light palette in values/colors.xml so existing
  layouts that reference @color/bg_base etc. flip automatically when the
  user picks dark mode (or follow-system at night).

  Brand teal stays the same in both themes for identity continuity.
-->
<resources>
    <!-- Legacy compat colors -->
    <color name="white">#FFFFFFFF</color>

    <!-- Brand -->
    <color name="brand_primary">@color/md_sys_color_primary</color>
    <color name="brand_secondary">@color/md_sys_color_tertiary</color>
    <color name="brand_cyan">@color/brand_primary</color>
    <color name="brand_cyan_glow">#335DDBB6</color>

    <!-- Backgrounds — M3 surface tonal stack -->
    <color name="bg_base">@color/md_sys_color_background</color>
    <color name="bg_surface">@color/md_sys_color_surface_container</color>
    <color name="bg_elevated">@color/md_sys_color_surface_container_high</color>
    <color name="bg_hover">@color/md_sys_color_surface_container_highest</color>

    <color name="surface_variant">@color/bg_elevated</color>

    <!-- Text -->
    <color name="text_primary">@color/md_sys_color_on_surface</color>
    <color name="text_secondary">@color/md_sys_color_on_surface_variant</color>
    <color name="text_muted">@color/md_sys_color_outline</color>

    <!-- Borders -->
    <color name="border_default">#26FFFFFF</color>

    <!-- Floating status overlay — dark variant (charcoal glass + faint
         brand-tinted ring). See values/colors.xml for the light pair. -->
    <color name="overlay_pill_background">#CC16161A</color>
    <color name="overlay_pill_stroke">#335DDBB6</color>

    <!-- Status -->
    <color name="status_success">@color/overdrive_status_success</color>
    <color name="status_warning">@color/overdrive_status_warning</color>
    <color name="status_danger">@color/overdrive_status_danger</color>
    <!-- Informational/confirmation blue — the overlay's "replay saved" hold. -->
    <color name="status_info">@color/overdrive_status_info</color>
    <color name="status_running">@color/status_success</color>
    <color name="status_stopped">@color/text_muted</color>
    <color name="status_error">@color/status_danger</color>
    <color name="status_starting">@color/status_warning</color>

    <!-- Accent legacy -->
    <color name="accent_orange">@color/status_warning</color>


    <!-- Logs -->

    <!-- Cards -->
    <color name="card_border">#1AFFFFFF</color>


    <!-- Switches -->
    <color name="switch_track_on">@color/brand_primary</color>
    <color name="switch_thumb_on">#003828</color>
    <color name="switch_track_off">@color/bg_hover</color>
    <color name="switch_thumb_off">@color/text_muted</color>

    <!-- Buttons -->

    <!-- Gradient -->
</resources>
